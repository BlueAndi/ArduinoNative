@startuml ArduinoNative

package "Library" as DeviceClasses {

  package "Interfaces" as Interfaces {

    abstract class "Print" as Print {
        + {abstract} write(data : uint8_t) : size_t
        + write(buffer : const uint8_t * , size : size_t ) : size_t
        + write(str : const char* ) : size_t
        + flush(void) : void

        + print(...) : size_t
        + println(...) : size_t
    }

    abstract class "Stream" as Stream {
        + {abstract} available(void) : int
        + {abstract} read(void) : int
        + {abstract} peek(void) : int

        + setTimeout(timeout : unsigned long) : void
        + getTimeout(void) : unsigned long
        + readBytes(buffer : uint8_t *, length : size_t ) : size_t
    }

    Print <|-- Stream : <<derive>>
  }



    class "HardwareSerial" as HardwareSerial {
        + begin(baudrate : unsigned long) : void
        + end(void) : void
        + setTxTimeoutMs(timeout : uint32_t) : void
        + setStream(stream : Stream* ) : void

        + write(data : uint8_t) : size_t
        + write(buffer : const uint8_t * , size : size_t ) : size_t
        + flush(void) : void
        + available(void) : int
        + read(void) : int
        + peek(void) : int
    }

    Stream <|-- HardwareSerial : <<derive>>

    class "Serial" as Serial <<instance>> {
    }

    HardwareSerial <.. Serial : <<instantiate>>

    class ConsoleCompat  <<namespace>>  {
        + isInteractive(void) : bool
        + enterRawMode(void) : bool
        + restoreMode(void) : void
        + readByte(void) : int
    }

    HardwareSerial ..> ConsoleCompat : <<use>>

    class Arduino  <<namespace>>  {

        + setup(
            getSystemTickFunc : (unsigned long (*)()   ),
            systemDelayFunc   : (void (*)(unsigned long)) ) : void

        + loop () : void
    }

    class ArduinoMain  {
        + main(argc : int, argv : char**) : int
    }

    note bottom of ArduinoMain
        Default entry point of the library,
        used if the application has no main().
        Supports the option --work-dir.
    end note

}
' ---  end of DeviceClasses

    package Application {

        class App {
            + setup() : void
            + loop() : void
        }

        ArduinoMain ..> App : <<call>>

        Arduino ..> App : <<call>>

        class "main" as AppMain {
            + main(argc : int, argv : char**) : int
        }

        note bottom of AppMain
            Optional, if an own time base
            is necessary, e.g. a simulation time.
        end note

        Arduino <.. AppMain :  <<use>>
    }

@enduml
