@startuml DynamicFlow

autoactivate on

participant ArduinoMain
participant App

== Default entry point of the library ==

-> ArduinoMain : main()

    ArduinoMain -> App : ::setup()
    ArduinoMain <-- App

    loop
        ArduinoMain -> App : ::loop()
        ArduinoMain <-- App
    end loop

== Application with own main() and own time base ==

participant "main" as AppMain
participant Arduino

-> AppMain : main()

    AppMain -> Arduino : Arduino::setup(getSystemTickFunc, systemDelayFunc)

        Arduino ->  App :   ::setup()
        Arduino <-- App

    AppMain <-- Arduino

    loop
        AppMain -> Arduino : Arduino::loop()

            Arduino ->  App :   ::loop()
            Arduino <-- App

        AppMain <-- Arduino
    end loop

@enduml
